# PostgreSQL
POSTGRES_PASSWORD=simulaordem

# API
JWT_SECRET=gere-uma-string-longa-e-aleatoria
CORS_ORIGIN=https://simulaordem.com.br
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Mesmo valor nos dois (ver docs/GOOGLE_OAUTH.md)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_API_URL=/api

# Tutor IA (Gemini API — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# E-mail transacional (Hostinger SMTP — hPanel → Conecte apps e dispositivos)
APP_URL=https://simulaordem.com.br
EMAIL_FROM=SimulaOrdem <suporte@simulaordem.com.br>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=suporte@simulaordem.com.br
SMTP_PASS=
EMAIL_2FA_ENABLED=true
# Alternativa: Resend (https://resend.com) — use RESEND_API_KEY em vez de SMTP
# RESEND_API_KEY=

# Asaas — https://sandbox.asaas.com (ver docs/ASAAS.md)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PRO_VALUE=24.90
ASAAS_RETA_VALUE=59.90
